# subgen for NVIDIA Jetson (arm64 / aarch64) with CUDA-accelerated transcription.
#
# Why a separate Dockerfile: upstream Dockerfile is based on nvidia/cuda (amd64
# only for the tags subgen uses) and pip installs ctranslate2, whose PyPI
# aarch64 wheels are CPU-only builds. This image instead:
#   * starts from plain ubuntu:24.04 (matches Jetson L4T r38/r39 host glibc),
#   * gets CUDA userspace (cuBLAS/cuDNN/cudart 12.9) from NVIDIA's own pip
#     wheels (manylinux aarch64), and
#   * installs the native CUDA build of ctranslate2 published by
#     pypi.jetson-ai-lab.io (jp6/cu129 index) instead of the CPU wheel.
# The driver itself (libcuda.so.1) is mounted into the container by
# nvidia-container-toolkit from the HOST (L4T r36+/JetPack 6+), so no
# cuda-compat libs are baked in (that combination breaks on Orin/Thor).
#
# Nothing here compiles CUDA code, so the image builds on any arm64 machine
# with no GPU, including GitHub's hosted ubuntu-24.04-arm runners (see
# .github/workflows/build_JETSON.yml).
#
# Build ON the Jetson (or any arm64 box):  docker build -f Dockerfile.jetson -t subgen:jetson-cuda .
# Run with the GPU:                        docker run --runtime nvidia ... (see docker-compose.jetson.yml)
#
# Every external input below is pinned by content hash. To bump one, change
# the ARG and its hash together (see docs/JETSON.md, "Version-matching rules").

# Multi-arch index digest for ubuntu:24.04.
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

# ---------------------------------------------------------------------------
# Stage 1: fetch the CUDA-enabled libctranslate2.so.4.5.0.
#
# The native ctranslate2 wheels at pypi.jetson-ai-lab.io ship only the Python
# bindings and expect the shared library to be installed system-wide. The
# library lives in one ~38 MB layer of the community image
# dustynv/speaches:r36.4.0-cu128-24.04 (manifest digest
# sha256:d48c102846654e84ee6df55a47792dd401f507e1df69786bcae13e03c87e1982).
# Pulling that whole image is ~7 GB compressed, so instead we download only
# that layer blob from Docker Hub by digest, verify it, and extract the .so.
# ---------------------------------------------------------------------------
FROM ${UBUNTU_IMAGE} AS ct2lib

ARG CT2_LIB_REPO=dustynv/speaches
ARG CT2_LIB_LAYER=sha256:7f55a71db938c6cba26d6cbe22b74af0a47f082f9e2395d127b4cde3c9b1e636
ARG CT2_LIB_FILE=libctranslate2.so.4.5.0
ARG CT2_LIB_SHA256=a8e17a61ebd8f6e818ec3f739fe06d711b214c3a3880696160b071d406b9456f

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    token=$(curl -fsSL "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${CT2_LIB_REPO}:pull" \
        | sed -E 's/.*"token":"([^"]+)".*/\1/') && \
    curl -fsSL -H "Authorization: Bearer ${token}" \
        "https://registry-1.docker.io/v2/${CT2_LIB_REPO}/blobs/${CT2_LIB_LAYER}" -o /tmp/layer.tgz && \
    echo "${CT2_LIB_LAYER#sha256:}  /tmp/layer.tgz" | sha256sum -c - && \
    mkdir -p /out && \
    tar -xzf /tmp/layer.tgz -C /out "usr/local/lib/${CT2_LIB_FILE}" && \
    echo "${CT2_LIB_SHA256}  /out/usr/local/lib/${CT2_LIB_FILE}" | sha256sum -c - && \
    rm -rf /tmp/layer.tgz /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Stage 2: runtime image
# ---------------------------------------------------------------------------
FROM ${UBUNTU_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Apt packages: own layer so pip changes don't re-run apt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg python3 python3-venv python3-pip curl gosu tzdata ca-certificates libgomp1

ARG CT2_LIB_FILE=libctranslate2.so.4.5.0
COPY --from=ct2lib /out/usr/local/lib/${CT2_LIB_FILE} /usr/local/lib/
RUN ln -sf "${CT2_LIB_FILE}" /usr/local/lib/libctranslate2.so.4 && ldconfig

# Native CUDA ctranslate2 Python bindings. The #sha256= fragment makes pip
# refuse the download if the file at that URL ever changes. The wheel version
# must match CT2_LIB_FILE above.
ARG CT2_WHEEL_URL=https://pypi.jetson-ai-lab.io/jp6/cu129/+f/c2f/8c3c38cb6d1f2/ctranslate2-4.5.0-cp312-cp312-linux_aarch64.whl#sha256=c2f8c3c38cb6d1f278123a4f88ba45ea5c47a8e3a7320346b17e10215c1baefb

# CUDA-accelerated CTranslate2 + cu12 runtime libs + torch (CPU build on
# aarch64 is fine; subgen only uses torch for optional clear_vram bookkeeping).
COPY requirements.jetson.txt /
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install -U pip && \
    /opt/venv/bin/pip install --no-deps "${CT2_WHEEL_URL}" && \
    /opt/venv/bin/pip install -r /requirements.jetson.txt && \
    apt-get purge -y --auto-remove python3-pip && \
    rm -rf /var/lib/apt/lists/*

ENV PATH=/opt/venv/bin:$PATH \
    LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib

WORKDIR /subgen

# App files last: changes here don't bust the layers above
COPY launcher.py subgen.py language_code.py /subgen/

RUN mkdir -p /cache && chmod 777 /cache

ENV XDG_CACHE_HOME=/cache \
    HF_HOME=/cache/huggingface \
    MPLCONFIGDIR=/cache/matplotlib \
    PYTHONUNBUFFERED=1

COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "launcher.py"]
