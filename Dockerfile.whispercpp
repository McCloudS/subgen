FROM ghcr.io/ggerganov/whisper.cpp:main-vulkan

# Python + subgen runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    ffmpeg curl gosu tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.whispercpp.txt /
RUN python3 -m pip install --no-cache-dir -U -r /requirements.whispercpp.txt \
    && apt-get purge -y --auto-remove python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /subgen
COPY launcher.py subgen.py language_code.py /subgen/

RUN mkdir -p /cache/models && chmod 777 /cache

ENV XDG_CACHE_HOME=/cache \
    PYTHONUNBUFFERED=1 \
    TRANSCRIBE_BACKEND=whispercpp \
    WHISPER_CPP_MODEL=/cache/models/ggml-model.bin

COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "launcher.py"]
