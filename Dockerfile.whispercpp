ARG BASE_IMAGE=ghcr.io/ggml-org/whisper.cpp:main
FROM ${BASE_IMAGE}

# Python + subgen runtime deps
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    ffmpeg curl gosu tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.whispercpp.txt /
RUN pip install --no-cache-dir -U -r /requirements.whispercpp.txt \
    && apt-get purge -y --auto-remove python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /subgen
COPY launcher.py subgen.py language_code.py /subgen/

RUN mkdir -p /cache/models && chmod 777 /cache

ENV XDG_CACHE_HOME=/cache \
    PYTHONUNBUFFERED=1 \
    TRANSCRIBE_BACKEND=whispercpp \
    WHISPER_CPP_MODEL=/cache/models/ggml-model.bin

COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "launcher.py"]
